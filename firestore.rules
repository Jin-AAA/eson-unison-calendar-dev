rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Shape and value checks shared by create and update.
    function isValidToken(tokenId, data) {
      return data.keys().hasAll([
          'token', 'tokenHash', 'project', 'platform', 'userAgent',
          'language', 'browserLanguage', 'timezone', 'pageUrl',
          'permission', 'enabled', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'token', 'tokenHash', 'project', 'platform', 'userAgent',
          'language', 'browserLanguage', 'timezone', 'pageUrl',
          'permission', 'enabled', 'createdAt', 'updatedAt'
        ])
        && tokenId.matches('^[0-9a-f]{64}$')
        && data.tokenHash == tokenId
        && data.token is string
        && data.token.size() >= 20
        && data.token.size() <= 4096
        && data.project == 'ESON × UNISON Calendar'
        && data.platform in ['iOS / iPadOS', 'Android', 'macOS', 'Windows', 'Unknown']
        && data.userAgent is string
        && data.userAgent.size() <= 1024
        && data.language in ['zh', 'ko', 'ja', 'en']
        && data.browserLanguage is string
        && data.browserLanguage.size() <= 100
        && data.timezone is string
        && data.timezone.size() <= 100
        && data.pageUrl is string
        && data.pageUrl.size() <= 2048
        && data.permission == 'granted'
        && data.enabled == true
        && data.updatedAt == request.time;
    }

    // New device: createdAt must be the server time of this write.
    function canCreateToken(tokenId) {
      return isValidToken(tokenId, request.resource.data)
        && request.resource.data.createdAt == request.time;
    }

    // Same device saving again (token refresh, language switch).
    // createdAt may stay unchanged (calendar v31+) or be reset to now
    // (older site versions rewrite the whole doc), so both the test site
    // and the production site keep working with this single rules file.
    // The token itself must not change.
    function canUpdateToken(tokenId) {
      return isValidToken(tokenId, request.resource.data)
        && (request.resource.data.createdAt == resource.data.createdAt
            || request.resource.data.createdAt == request.time)
        && request.resource.data.token == resource.data.token;
    }

    match /tokens/{tokenId} {
      allow create: if canCreateToken(tokenId);
      allow update: if canUpdateToken(tokenId);
      allow read, delete: if false;
    }

    match /tokens-dev/{tokenId} {
      allow create: if canCreateToken(tokenId);
      allow update: if canUpdateToken(tokenId);
      allow read, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
